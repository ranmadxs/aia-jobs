# ─────────────────────────────────────────────────────────────────────────────
# aia-jobs — variables de entorno de ejemplo
# Copia a .env y completa los valores. Se cargan con python-dotenv.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB (donde se guardan los emails) ─────────────────────────────────────
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net

# MongoDB principal (transacciones BCI — destino de sync_trx)
MONGODB_URI_MAIN=mongodb+srv://usuario:password@cluster.mongodb.net

# ── Email (IMAP Yahoo) ────────────────────────────────────────────────────────
YAHOO_EMAIL=usuario@yahoo.com
YAHOO_APP_PASSWORD=tu-app-password

# ── Listener ──────────────────────────────────────────────────────────────────
# Intervalo de polling (segundos) usado cuando el servidor no soporta IDLE.
# ── BCI Cartola (PDF cifrado) ──────────────────────────────────────
LISTENER_POLL_INTERVAL=60

# ── BCI Cartola (PDF cifrado) ──────────────────────────────
BCI_PDF_PASSWORD=tu-clave-pdf-bci
